# Local development only; no real credentials.
APP_ENVIRONMENT=development
VITE_PROXY_TARGET=http://127.0.0.1:8000

# Synthetic PostgreSQL settings used by Docker Compose.
POSTGRES_DB=freight_local
POSTGRES_USER=freight_local
POSTGRES_PASSWORD=local_demo_only
DATABASE_URL=postgresql+psycopg://freight_local:local_demo_only@127.0.0.1:5432/freight_local
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Reserved for the future server-only freight adapter (not implemented).
FREIGHT_MODE=mock
FREIGHT_BASE_URL=
FREIGHT_API_KEY=
FREIGHT_COMPANY_ID=
FREIGHT_LOCATION_ID=
FREIGHT_ORIGIN_POSTAL_CODE=
