# Local development only; no real credentials.
APP_ENVIRONMENT=development
# Leave blank to disable local admin CRUD. For development/test only (at least 32 characters).
# Independent of Packsenvios; never expose this value through VITE_* variables.
LOCAL_ADMIN_KEY=
VITE_PROXY_TARGET=http://127.0.0.1:8000

# Synthetic PostgreSQL settings used by Docker Compose.
POSTGRES_DB=freight_local
POSTGRES_USER=freight_local
POSTGRES_PASSWORD=local_demo_only
DATABASE_URL=postgresql+psycopg://freight_local:local_demo_only@127.0.0.1:5432/freight_local
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Active server-only quote adapter. Mock is offline and explicitly synthetic.
FREIGHT_MODE=mock
FREIGHT_BASE_URL=
FREIGHT_API_KEY=
FREIGHT_COMPANY_ID=
FREIGHT_LOCATION_ID=
FREIGHT_ORIGIN_POSTAL_CODE=
FREIGHT_TIMEOUT_SECONDS=10
FREIGHT_CONNECT_TIMEOUT_SECONDS=3
FREIGHT_MAX_ATTEMPTS=2
FREIGHT_MAX_RETRY_WAIT_SECONDS=5
FREIGHT_MOCK_SCENARIO=quoted
# Local stable organization/environment namespace, never sent as a tenant selector.
FREIGHT_INTEGRATION_SCOPE=local-freight
